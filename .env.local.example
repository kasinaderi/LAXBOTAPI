# LAXSNIPER LX Environment Variables

# Deriv API Configuration
NEXT_PUBLIC_DERIV_APP_ID=your_app_id_here
NEXT_PUBLIC_DERIV_WEBSOCKET_URL=wss://ws.derivws.com/websockets/v3

# Firebase Configuration (Optional - for future backend)
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=

# Encryption Key (for API token storage)
# ENCRYPTION_KEY=your_32_character_encryption_key_here
